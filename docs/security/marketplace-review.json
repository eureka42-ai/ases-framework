  "schemaVersion": 1,
  "reviewStatus": "APPROVED",
  "reviewedAt": "2026-11-16",
  "reviewedBy": "Eureka42 ASES maintainers",
  "reviewScope": "First-party marketplace metadata and host plugin manifests in this repository; this is not a third-party code audit or guarantee about future releases. The Claude plugin also includes a static, dependency-free welcome script that prints the approved brand banner and does not access the workspace. This update covers the local Antigravity CLI plugin and its static welcome helper; no startup hook runs automatically.",
  "decision": "Publish the first-party listing with the controls and limitations recorded below.",
  "findings": [
    {
      "id": "MR-001",
      "severity": "INFO",
      "status": "DOCUMENTED",
      "detail": "The first-party plugins distribute onboarding instructions and metadata. They do not bundle a background service, installer script, model provider, or credential collector. Host actions remain subject to user/host approval. The Claude plugin bundles only a dependency-free static welcome script for the same banner; it does not read or write workspace files. The Claude and Antigravity plugins bundle only dependency-free static welcome scripts; they do not read or write workspace files."
    },
    {
      "id": "MR-002",
      "severity": "LOW",
      "status": "MITIGATED",
      "detail": "Instructions may call the ASES CLI, which can read or write the selected workspace when the user invokes a command. The review requires clear disclosure, explicit apply flags for writes, and preservation of the green Eureka42 CLI welcome."
    },
    {
      "id": "MR-003",
      "severity": "MEDIUM",
      "status": "ACCEPTED",
      "detail": "Marketplace installation executes host-controlled plugin/extension behavior. Users must review the host's displayed permissions and install only from the canonical Eureka42 repository; this repository gate does not attest to host marketplace infrastructure."
    }
  ],
