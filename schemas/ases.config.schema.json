{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eureka42.org/schemas/ases.config.schema.json",
  "title": "EUREKA42 ASES project configuration",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locale": {
          "type": "string",
          "enum": [
            "pt-BR",
            "en-US",
            "es-ES",
            "it-IT"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "host",
            "standalone",
            "headless",
            "offline"
          ]
        },
        "privacy": {
          "type": "string",
          "const": "local-only"
        }
      },
      "required": [
        "id",
        "name",
        "locale",
        "mode",
        "privacy"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "project"
  ],
  "additionalProperties": false
}
