{
  "name": "eureka42-ases-framework",
  "version": "0.0.0-dev",
  "private": true,
  "description": "EUREKA42 ASES Framework development workspace",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/copy-host-integrations.mjs && pnpm --filter @eureka42/ases-workflow-editor build",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "node scripts/check-config-schema.mjs && node --test packages/cli/dist/**/*.test.js scripts/*.test.mjs",
    "smoke": "node scripts/smoke-cli.mjs",
    "check": "tsc -b --pretty false && node scripts/check-config-schema.mjs && node --test packages/cli/dist/**/*.test.js && pnpm run integrations:validate",
    "test": "pnpm run build && pnpm run test:unit && pnpm run integrations:validate",
    "integrations:validate": "node scripts/validate-integrations.mjs",
    "supply-chain": "node scripts/supply-chain.mjs",
    "schema:generate": "pnpm build && node scripts/generate-config-schema.mjs",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}

